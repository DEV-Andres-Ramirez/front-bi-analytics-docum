# Copia este archivo como .env.local y completa los valores.

# ─── Acceso al aplicativo ─────────────────────────────────────────────
# Token único de acceso que se digita en /login (solo servidor, nunca NEXT_PUBLIC).
ACCESS_TOKEN=
# Secreto para firmar la cookie de sesión (JWT HS256). Mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
SESSION_SECRET=
# Duración de la sesión en horas.
SESSION_TTL_HOURS=8

# ─── Mapbox ───────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/andres-ramirez/cmqkorkc6003101s46xcreztw
# Estilo del mapa en tema oscuro: gemelo del anterior creado en Mapbox Studio en la cuenta
# del cliente (tierra #1A1F27, agua #10141A, etiquetas atenuadas). Si se deja vacío se usa
# mapbox://styles/mapbox/dark-v11 como respaldo.
NEXT_PUBLIC_MAPBOX_STYLE_DARK=

# ─── Fuente de datos ──────────────────────────────────────────────────
# mock = datos sintéticos anonimizados (por defecto) · postgres = BD real (pendiente)
DATA_SOURCE=mock

# ─── Base de datos (fase 2, vía túnel IAP → 127.0.0.1) ────────────────
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
